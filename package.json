{
  "name": "flyte",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:vectors": "turbo test --filter @flyte/aviation",
    "verify": "turbo typecheck test build && pnpm lint && pnpm lint:prose",
    "lint:prose": "node scripts/lint-prose.mjs",
    "backlog:sync": "node scripts/backlog-sync.mjs",
    "db:generate": "pnpm --filter @flyte/db generate",
    "db:migrate": "pnpm --filter @flyte/db migrate",
    "db:check:postgis": "pnpm --filter @flyte/db check:postgis"
  },
  "devDependencies": {
    "@flyte/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
