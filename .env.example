# Copy to .env.local and fill in. Never commit .env.local.
# Documented in docs/DATA_SOURCES.md §11.

# ─── Database ──────────────────────────────────────────────────────────────
# Neon connection string. During parallel agent work each lane uses its OWN
# Neon branch (lane-a / lane-b) so migrations cannot collide — see docs/LANES.md.
DATABASE_URL=postgresql://user:password@host.neon.tech/flyte?sslmode=require

# ─── Authentication (Better Auth) ──────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic link delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@flyte.czekanski.dev

# ─── Aeronautical data ─────────────────────────────────────────────────────
# OpenAIP client id, from your OpenAIP profile page.
# Data is CC BY-NC-SA — see docs/DATA_SOURCES.md §1 and §10 before shipping anything.
OPENAIP_CLIENT_ID=

# ─── NOTAM ─────────────────────────────────────────────────────────────────
# FAA API portal credentials. DO NOT build on these until FLY-002 confirms that
# EP** locations are actually covered. See docs/DATA_SOURCES.md §8.
FAA_CLIENT_ID=
FAA_CLIENT_SECRET=

# ─── Infrastructure ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
PDF_SERVICE_URL=http://localhost:3001

# Sent to every public API we call. aviationweather.gov filters generic agents.
APP_USER_AGENT=Flyte/0.1 (+https://flyte.czekanski.dev)

# ─── Local development ─────────────────────────────────────────────────────
# Lane A uses 3000, Lane B uses 3001.
PORT=3000
NODE_ENV=development
